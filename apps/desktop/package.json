{
  "name": "@icm/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Analog Canvas",
  "homepage": "https://github.com/CanvasQAQ/analog-canvas-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/CanvasQAQ/analog-canvas-desktop.git"
  },
  "desktopName": "analog-canvas.desktop",
  "description": "Cross-platform offline Analog Canvas schematic editor",
  "author": "Analog Canvas contributors; desktop shell adapted from LXY-freshman",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build:preview": "node scripts/build.mjs",
    "build:app": "node scripts/build.mjs",
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "dist:linux": "electron-builder --config electron-builder.yml --linux --x64 --publish never",
    "dist:win": "electron-builder --config electron-builder.yml --win --x64 --publish never",
    "dist:mac": "electron-builder --config electron-builder.yml --mac --publish never",
    "package:preview": "node scripts/package-preview.mjs",
    "archive:preview": "node scripts/archive-preview.mjs",
    "test:preview": "node scripts/accept-preview.mjs",
    "security:preview": "node ../../scripts/desktop-package-security.mjs"
  },
  "devDependencies": {
    "@icm/edit-engine": "workspace:*",
    "@icm/project-protocol": "workspace:*",
    "electron": "44.4.2",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "rcedit": "5.0.2",
    "zod": "4.4.3"
  }
}
